# Postgres (Neon / Vercel Postgres). Use the pooled connection string on Vercel.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# Neon also gives you a direct (non-pooled) URL — needed by `prisma migrate`.
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# Auth
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Vercel Blob (for product/review image uploads, added in a later step)
BLOB_READ_WRITE_TOKEN=""
